EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The anon key is safe to expose in the client bundle by design — Row Level
# Security is what protects the data, not keeping this key secret. Never put
# a service_role key in this file or anywhere in the app's source.
#
# For the deployed Vercel build, set these same two variables in the Vercel
# project's Settings -> Environment Variables (not just here locally) — a
# static `expo export --platform web` bundle bakes them in at build time.
